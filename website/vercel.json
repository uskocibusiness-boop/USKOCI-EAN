{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/privatnost",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/uslovi",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/brisanje-naloga",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/podrska",
      "destination": "/support",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}