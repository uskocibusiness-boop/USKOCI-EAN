      },
      {
        "name": "ai_test_usage_v5_model_check",
        "definition": "CHECK (((length(btrim(model)) >= 1) AND (length(btrim(model)) <= 100)))"
      },
      {
        "name": "ai_test_usage_v5_output_tokens_check",
        "definition": "CHECK (((output_tokens >= 0) AND (output_tokens <= 10000000)))"
      },
