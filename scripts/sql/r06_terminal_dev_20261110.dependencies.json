      "relation": "private.qa_ai_commands",
      "triggers": [
        {
          "name": "qa_ai_closure_guard",
          "enabled": "O",
          "function": "private.closure_guard_owned_write()",
          "internal": false,
          "definition": "CREATE TRIGGER qa_ai_closure_guard BEFORE INSERT OR UPDATE ON private.qa_ai_commands FOR EACH ROW EXECUTE FUNCTION private.closure_guard_owned_write('ACCOUNT', 'account_id')"
        }
      ],
      "force_rls": true,
      "constraints": [
        {
          "name": "qa_ai_commands_account_id_client_request_id_key",
          "type": "u",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "UNIQUE (account_id, client_request_id)"
        },
        {
          "name": "qa_ai_commands_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK ((command_type = 'ASK'::text) = (question_id IS NULL))"
        },
        {
          "name": "qa_ai_commands_check1",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK ((state = 'COMMITTED'::text) = (receipt IS NOT NULL))"
        },
        {
          "name": "qa_ai_commands_check2",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (state <> 'READY'::text OR outcome = 'ALLOW'::text AND (command_type = 'ASK'::text OR materiality = 'NON_MATERIAL'::text))"
        },
        {
          "name": "qa_ai_commands_command_type_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (command_type = ANY (ARRAY['ASK'::text, 'ANSWER'::text]))"
        },
        {
          "name": "qa_ai_commands_materiality_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (materiality = ANY (ARRAY['NON_MATERIAL'::text, 'MATERIAL'::text]))"
        },
        {
          "name": "qa_ai_commands_need_revision_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (need_revision > 0)"
        },
        {
          "name": "qa_ai_commands_outcome_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (outcome = ANY (ARRAY['ALLOW'::text, 'CLARIFY'::text, 'REVIEW'::text, 'BLOCK'::text]))"
        },
        {
          "name": "qa_ai_commands_pkey",
          "type": "p",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "qa_ai_commands_request_hash_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (request_hash ~ '^[a-f0-9]{64}$'::text)"
        },
        {
          "name": "qa_ai_commands_state_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (state = ANY (ARRAY['PROCESSING'::text, 'READY'::text, 'REJECTED'::text, 'STALE'::text, 'COMMITTED'::text, 'CANCELLED'::text]))"
        },
        {
          "name": "qa_ai_commands_text_sha256_check",
          "type": "c",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (text_sha256 ~ '^[a-f0-9]{64}$'::text)"
        }
      ]
