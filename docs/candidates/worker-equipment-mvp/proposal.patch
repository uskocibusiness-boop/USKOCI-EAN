+function omitNewEquipment(output: Record<string,any>) {
+  const {tools,vehicles,...patch}=output.patch;
+  const proposed=Object.hasOwn(output.patch,'tools')||Object.hasOwn(output.patch,'vehicles');
+  if (!proposed || !['ALLOW','CLARIFY'].includes(output.safety)) return {...output,patch};
+  // An equipment proposal may have a matching false acknowledgement in prose.
+  // Replace that prose, retaining only separate questions clearly unrelated to
+  // the proposed equipment. A mixed question cannot safely be split.
+  const names=[...(Array.isArray(tools)?tools:[]),...(Array.isArray(vehicles)?vehicles:[])]
+    .filter((value:unknown):value is string=>typeof value==='string'&&value.trim().length>0)
+    .map((value:string)=>value.trim().toLocaleLowerCase());
+  const equipment=/(?:^|[^\p{L}])(?:alat[\p{L}]*|vozil[\p{L}]*|oprem[\p{L}]*|kombi(?:jem|ja|ju|na)?|automobil[\p{L}]*|kamion[\p{L}]*|bušilic[\p{L}]*|kolic[\p{L}]*)(?=$|[^\p{L}])/iu;
+  const questions=(output.assistantMessage.match(/[^.!?\n]*\?/gu)??[])
+    .map((question:string)=>question.trim())
+    .filter((question:string)=>question.length<=200 && !equipment.test(question)
+      && !names.some((name:string)=>question.toLocaleLowerCase().includes(name)))
+    .slice(0,3);
+  const otherChanges=Object.keys(patch).length>0?'Ostale jasne izmene su u nacrtu. ':'';
+  return {...output,patch,assistantMessage:otherChanges+
+    'Alat i vozila ne menjam kroz razgovor; postojeći podaci ostaju u pregledu profila.'+
+    (questions.length?' '+questions.join(' '):'')};
+}
+
